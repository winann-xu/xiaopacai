<?xml version="1.0" encoding="utf-8"?>
<!-- [TASK-D1-02] 小趴菜儿童端 AndroidManifest -->
<!-- 声明应用组件、权限请求与系统功能依赖 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- === 权限声明 === -->
    <!-- 使用情况访问权限（核心：采集应用使用时长） -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 无障碍服务权限（用于超时停用拦截） -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- [TASK-OPT-4] 紧急公告全屏通知（Android 14+ 需用户授权） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 网络权限（P2P 通信） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 相机权限（家长端/儿童端扫码） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 开机自启动（可选，OEM 保活增强） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- [TASK-D3-03] 设备管理器权限（防卸载核心） -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- 查询已安装应用（用于白名单/黑名单过滤） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 忽略电池优化（保活增强） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- [TASK-APP-UPDATE-V1] 安装更新包（PackageInstaller/ACTION_VIEW 均需「允许安装未知来源」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- === 应用配置 === -->
    <application
        android:name=".XiaopacaiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xiaopacai"
        android:usesCleartextTraffic="true"
        tools:ignore="UsesCleartextTraffic"
        tools:targetApi="34">

        <!-- [TASK-OPT-12-P3/P4] 中继 REST（登录/注册）走局域网 HTTP；P2P 数据通道仍为 TLS。
             生产部署建议 Web 侧配置 HTTPS 后再收紧 cleartext。 -->
        <!-- 主 Activity（入口） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Xiaopacai">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 拦截覆盖 Activity（全屏锁屏界面） -->
<!-- [FIX] 儿童端快捷入口：应用分类 / 守护状态（此前未注册导致点击无反应） -->
<activity
    android:name=".ui.settings.AppCategoryActivity"
    android:exported="false" />
        <activity
            android:name=".ui.settings.GuardianStatusActivity"
            android:exported="false" />
        <!-- [TASK-STRICT-PROVISION-V1] 强管制模式入口（ADR 0018） -->
        <activity
            android:name=".ui.strict.StrictProvisionActivity"
            android:exported="false" />

        <!-- [TASK-STRICT-PROVISION-V1] v1.3.2 通知栏配对（ADR 0018）：
             ColorOS 真机实测配对服务仅在前台存活，配对码改由通知栏内联输入 -->
        <receiver
            android:name=".ui.strict.PairingCodeReceiver"
            android:exported="false" />
        <service
            android:name=".ui.strict.PairingProvisionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false" />

        <activity
            android:name=".ui.scan.QrScannerActivity"
            android:exported="false" />
<activity
    android:name=".ui.BlockOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Xiaopacai" />

        <!-- [TASK-OPT-4] 紧急公告全屏置顶界面（儿童必须确认） -->
        <activity
            android:name=".ui.overlay.AnnouncementOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Xiaopacai" />

        <!-- 前台服务（时长采集 + 超时守护） -->
        <!-- [TASK-HARDENING-V1.1.1] 1-A：stopWithTask=false，上滑最近任务不清除服务（OPPO 真机根因） -->
        <service
            android:name=".service.GuardianForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false" />

        <!-- 无障碍服务（超时停用拦截实现） -->
        <service
            android:name=".service.GuardianAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- 开机广播接收器（OEM 保活增强） -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- [TASK-MILESTONE-V3] 需求 5：守护兜底闹钟 + 上滑结束恢复接收器
             （此前漏注册导致 AlarmManager 兜底链路静默失效，本次补声明） -->
        <receiver
            android:name=".service.GuardianAlarmReceiver"
            android:exported="false" />

        <!-- [TASK-HARDENING-V1.1.1] Bug4-A：应用更新后权限即时自检
             （更新会关停无障碍服务，第一时间发现并高优通知；
             亮屏/解锁由守护服务动态注册，回前台由 Application 回调） -->
        <receiver
            android:name=".service.GuardianEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- [TASK-ROLE-P1] 家长端 P2P 入站监听服务 -->
        <!-- [TASK-HARDENING-V1.1.1] 1-A：stopWithTask=false，上滑最近任务不清除服务（OPPO 真机根因） -->
        <service
            android:name=".p2p.ParentP2PListenerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false" />

        <!-- [TASK-D3-03] 设备管理器接收器（防卸载保护） -->
        <receiver
            android:name=".service.GuardianDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:description="@string/device_admin_description">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

        <!-- [TASK-APP-UPDATE-V1] 安装会话结果接收器（PackageInstaller session commit 回执，仅日志） -->
        <receiver
            android:name=".util.InstallResultReceiver"
            android:exported="false" />

        <!-- [TASK-APP-UPDATE-V1] FileProvider：向系统安装器暴露已校验的更新包（仅 app-updates 目录） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updatefileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
