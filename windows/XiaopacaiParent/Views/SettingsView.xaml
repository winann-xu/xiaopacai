<!-- [TASK-D1-03] 小趴菜家长端设置页面 -->
<!-- 应用基础设置：数据目录、网络端口、加密选项 -->
<Page x:Class="XiaopacaiParent.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="⚙️ 设置" Style="{StaticResource PageTitleStyle}" />

            <!-- === 数据存储设置 === -->
            <TextBlock Text="数据存储" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,12" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="数据目录" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="儿童使用数据、策略配置、公告历史存于此目录。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DataDirTextBox" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="OnBrowseDataDirClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- === 网络设置 === -->
            <TextBlock Text="网络" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- P2P 监听端口 -->
                    <TextBlock Text="P2P 监听端口" FontWeight="SemiBold" />
                    <TextBlock Text="家长端监听儿童端连接的 TCP 端口（默认 9527）。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="ListenPortTextBox" Text="9527" Width="120"
                             HorizontalAlignment="Left" />

                    <Separator Margin="0,12" />

                    <!-- TLS 证书 -->
                    <TextBlock Text="TLS 证书" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="用于 P2P 双向认证的自签名证书。首次使用自动生成。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,8" />
                    <Button Content="🔑 重新生成证书" Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Left"
                            Click="OnRegenerateCertClick" />

                    <Separator Margin="0,12" />

                    <!-- [SEC-P1] 设备配对：一次性配对码 + 证书指纹 -->
                    <TextBlock Text="设备配对" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="儿童端首次连接需输入一次性配对码；已配对设备凭客户端证书指纹自动认证。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock Text="服务器证书指纹（儿童端扫码/手动配对比对用）"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="CertFingerprintTextBox" IsReadOnly="True"
                             TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="🔢 生成配对码（5 分钟有效）"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Click="OnGeneratePairingCodeClick" />
                        <TextBox x:Name="PairingCodeTextBox" Width="120" Margin="8,0,0,0"
                                 VerticalAlignment="Center" IsReadOnly="True" />
                    </StackPanel>
                    <TextBlock x:Name="PairingCodeHintText" Text=""
                               Foreground="Gray" FontSize="12" />
                    <Button Content="📱 显示配对二维码（儿童端扫码一键配对）"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnShowPairingQrClick" />
                </StackPanel>
            </Border>

            <!-- === 安全设置 === -->
            <TextBlock Text="安全" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox x:Name="DpapiEncryptionCheck" Content="使用 DPAPI 二次加密数据库凭据（推荐）"
                              IsChecked="True" Margin="0,0,0,8" />
                    <TextBlock Text="DPAPI 使用当前 Windows 用户账户加密密钥，额外提高安全性。"
                               Foreground="Gray" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- === 保存按钮 === -->
            <Button Content="💾 保存设置" Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="120" HorizontalAlignment="Left" Margin="0,24,0,0"
                    Click="OnSaveSettingsClick" />
        </StackPanel>
    </ScrollViewer>
</Page>
