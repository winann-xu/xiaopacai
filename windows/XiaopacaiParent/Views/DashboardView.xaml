<!-- [TASK-D1-03] 小趴菜家长端仪表盘页面 -->
<!-- 设备状态卡片 + 今日总览 + 快捷操作入口 -->
<Page x:Class="XiaopacaiParent.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="仪表盘">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- 页面标题 -->
            <TextBlock Text="📊 仪表盘" Style="{StaticResource PageTitleStyle}" />

            <!-- === 摘要卡片行 === -->
            <WrapPanel Margin="0,0,0,16">
                <!-- 已连接设备数 -->
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="已连接设备" Foreground="Gray" FontSize="13" />
                        <TextBlock x:Name="ConnectedCountText" Text="0" FontSize="36"
                                   FontWeight="Bold" Foreground="#4CAF50" />
                        <TextBlock Text="台在线" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 今日使用时长 -->
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="今日使用" Foreground="Gray" FontSize="13" />
                        <TextBlock x:Name="TodayUsageText" Text="0 分钟" FontSize="36"
                                   FontWeight="Bold" Foreground="#FF9800" />
                        <TextBlock Text="累计时长" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 超时设备数 -->
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="超时停用" Foreground="Gray" FontSize="13" />
                        <TextBlock x:Name="TimeoutCountText" Text="0" FontSize="36"
                                   FontWeight="Bold" Foreground="#E53935" />
                        <TextBlock Text="台已停用" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 待处理公告 -->
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="公告状态" Foreground="Gray" FontSize="13" />
                        <TextBlock x:Name="AnnouncementCountText" Text="0" FontSize="36"
                                   FontWeight="Bold" Foreground="#2196F3" />
                        <TextBlock Text="条已发布" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- === 快捷操作区 === -->
            <TextBlock Text="快捷操作" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12" />
            <WrapPanel>
                <Button Content="⚙️ 超时处理配置" Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,12,12" Width="160"
                        Click="OnTimeoutConfigClick" />
                <Button Content="📱 添加儿童设备" Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,12,12" Width="160"
                        Click="OnAddDeviceClick" />
                <Button Content="📢 发布公告" Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,12,12" Width="160"
                        Click="OnSendAnnouncementClick" />
                <Button Content="📈 查看报告" Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,12,12" Width="160"
                        Click="OnViewReportClick" />
            </WrapPanel>

            <!-- === 最近事件列表（占位） === -->
            <TextBlock Text="最近事件" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12" />
            <Border Style="{StaticResource CardStyle}" MinHeight="200">
                <TextBlock Text="暂无最近事件。设备连接后，超时停用、公告发送等事件将在此显示。"
                           Foreground="Gray" VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
