<!-- [TASK-D2-02] 小趴菜家长端策略配置页面 -->
<!-- 管理儿童设备的使用策略：每日限额、就寝时段、分类限制、白名单/黑名单 -->
<Page x:Class="XiaopacaiParent.Views.PolicyView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="策略配置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- 页面标题 -->
            <TextBlock Text="⚙️ 策略配置" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="为儿童设备设置使用规则，所有策略实时同步到设备端。"
                       Foreground="Gray" FontSize="13" Margin="0,0,0,20" />

            <!-- === 每日使用限额 === -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="⏰ 每日使用限额" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="设置孩子每天可以使用的总时长（分钟）" Foreground="Gray" FontSize="12" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DailyLimitSlider"
                                Minimum="30" Maximum="480" Value="120"
                                TickFrequency="30" IsSnapToTickEnabled="True"
                                Width="300" VerticalAlignment="Center"
                                ValueChanged="OnDailyLimitChanged" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Run x:Name="DailyLimitValue" Text="120" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" />
                            <Run Text=" 分钟" FontSize="14" Foreground="Gray" />
                        </TextBlock>
                        <Button Grid.Column="2" Content="💾 保存" Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="80" Click="OnSaveDailyLimit" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- === 就寝时段 === -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="🌙 就寝时段" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="就寝期间设备将被锁定，仅允许紧急电话。" Foreground="Gray" FontSize="12" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="开始时间" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                        <TextBox x:Name="SleepStartBox" Grid.Column="1" Text="21:00"
                                 Width="80" materialDesign:HintAssist.Hint="HH:mm" />
                        <TextBlock Grid.Column="2" Text="结束时间" VerticalAlignment="Center"
                                   Margin="16,0,8,0" FontSize="13" />
                        <TextBox x:Name="SleepEndBox" Grid.Column="3" Text="07:00"
                                 Width="80" materialDesign:HintAssist.Hint="HH:mm" />
                        <Button Grid.Column="4" Content="💾 保存" Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="80" Margin="16,0,0,0" Click="OnSaveSleepTime" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- === 分类限额 === -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="📂 分类限额" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="按应用分类设置时长上限（超出后该分类应用被锁定）"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 游戏限额 -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="🎮 游戏" FontSize="14" FontWeight="SemiBold" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="GameLimitSlider" Minimum="10" Maximum="240"
                                        Value="60" TickFrequency="10" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Run x:Name="GameLimitValue" Text="60" FontSize="18" FontWeight="Bold" Foreground="#FF9800" />
                                    <Run Text=" 分钟" FontSize="12" Foreground="Gray" />
                                </TextBlock>
                                <Button Grid.Column="2" Content="💾" Width="50" Margin="8,0,0,0"
                                        Click="OnSaveGameCategory" />
                            </Grid>
                        </StackPanel>

                        <!-- 社交限额 -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="💬 社交" FontSize="14" FontWeight="SemiBold" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SocialLimitSlider" Minimum="10" Maximum="240"
                                        Value="90" TickFrequency="10" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Run x:Name="SocialLimitValue" Text="90" FontSize="18" FontWeight="Bold" Foreground="#2196F3" />
                                    <Run Text=" 分钟" FontSize="12" Foreground="Gray" />
                                </TextBlock>
                                <Button Grid.Column="2" Content="💾" Width="50" Margin="8,0,0,0"
                                        Click="OnSaveSocialCategory" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 视频限额 -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="🎬 视频" FontSize="14" FontWeight="SemiBold" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="VideoLimitSlider" Minimum="10" Maximum="240"
                                        Value="90" TickFrequency="10" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Run x:Name="VideoLimitValue" Text="90" FontSize="18" FontWeight="Bold" Foreground="#E53935" />
                                    <Run Text=" 分钟" FontSize="12" Foreground="Gray" />
                                </TextBlock>
                                <Button Grid.Column="2" Content="💾" Width="50" Margin="8,0,0,0"
                                        Click="OnSaveVideoCategory" />
                            </Grid>
                        </StackPanel>

                        <!-- 学习：不限时（仅显示） -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="📚 学习" FontSize="14" FontWeight="SemiBold" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="不限制" FontSize="18" FontWeight="Bold"
                                           Foreground="#4CAF50" VerticalAlignment="Center" />
                                <TextBlock Text="学习类应用始终可用" Foreground="Gray"
                                           FontSize="12" Margin="80,4,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- === 应用黑名单 === -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="🚫 应用黑名单" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="黑名单中的应用将被完全禁止启动。每行输入一个应用包名。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,12" />
                    <TextBox x:Name="BlacklistBox" Height="100" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="com.example.game&#x0a;com.example.social" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 保存黑名单" Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="120" Click="OnSaveBlacklist" />
                        <Button Content="📋 常用模板" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="100" Margin="12,0,0,0" Click="OnLoadBlacklistTemplate" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- === 应用白名单 === -->
            <materialDesign:Card Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="✅ 应用白名单" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="超时停用后仍可使用的应用（如学习类、电话、短信）。每行一个应用包名。"
                               Foreground="Gray" FontSize="12" Margin="0,0,0,12" />
                    <TextBox x:Name="WhitelistBox" Height="100" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="com.android.phone&#x0a;com.android.contacts&#x0a;com.example.study" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 保存白名单" Style="{StaticResource MaterialDesignRaisedButton}"
                                Width="120" Click="OnSaveWhitelist" />
                        <Button Content="📋 学习类模板" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="100" Margin="12,0,0,0" Click="OnLoadWhitelistTemplate" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
