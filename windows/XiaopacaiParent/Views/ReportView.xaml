<!-- [TASK-D3-01] 小趴菜家长端报告视图页面 -->
<!-- 使用数据可视化展示儿童端的使用统计报告（日报/周报） -->
<Page x:Class="XiaopacaiParent.Views.ReportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="使用报告">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- ===== 页面标题与模式切换 ===== -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📊 使用报告" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="儿童端使用时长统计与分析"
                               Foreground="Gray" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 设备选择 -->
                    <ComboBox x:Name="DeviceSelector" Width="160" Margin="0,0,8,0"
                              materialDesign:HintAssist.Hint="选择设备"
                              SelectionChanged="OnDeviceChanged" />

                    <!-- 报告类型切换 -->
                    <Button x:Name="DailyBtn" Content="📅 日报" Width="80"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnDailyReportClick" />
                    <Button x:Name="WeeklyBtn" Content="📈 周报" Width="80"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnWeeklyReportClick" />

                    <!-- 导出按钮 -->
                    <Button Content="📥 导出报告" Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="OnExportReportClick" />
                </StackPanel>
            </Grid>

            <!-- ===== 总览卡片行 ===== -->
            <WrapPanel Margin="0,0,0,16">
                <!-- 总使用时长 -->
                <Border Style="{StaticResource CardStyle}" Width="240" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="总使用时长" Foreground="Gray" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="TotalHoursText" Text="0.0" FontSize="36"
                                       FontWeight="Bold" Foreground="#1976D2" />
                            <TextBlock Text=" 小时" FontSize="16" Foreground="Gray"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                        <TextBlock x:Name="TotalMinutesSubText" Text="0 分钟"
                                   Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 日均使用 -->
                <Border Style="{StaticResource CardStyle}" Width="240" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="日均使用" Foreground="Gray" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="AvgDailyText" Text="0.0" FontSize="36"
                                       FontWeight="Bold" Foreground="#FF9800" />
                            <TextBlock Text=" 小时/天" FontSize="16" Foreground="Gray"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                        <TextBlock x:Name="AvgDailySubText" Text="统计周期内" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 超时天数 -->
                <Border Style="{StaticResource CardStyle}" Width="240" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="超时天数" Foreground="Gray" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="ExceedDaysText" Text="0" FontSize="36"
                                       FontWeight="Bold" Foreground="#E53935" />
                            <TextBlock Text=" 天" FontSize="16" Foreground="Gray"
                                       VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                        <TextBlock x:Name="TotalDaysText" Text="共 0 天"
                                   Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 趋势 -->
                <Border Style="{StaticResource CardStyle}" Width="240" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="使用趋势" Foreground="Gray" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="TrendArrowText" Text="→" FontSize="36"
                                       FontWeight="Bold" Foreground="Gray" />
                            <TextBlock x:Name="TrendPercentText" Text="0%" FontSize="20"
                                       FontWeight="Bold" Foreground="Gray"
                                       VerticalAlignment="Bottom" Margin="8,0,0,6" />
                        </StackPanel>
                        <TextBlock Text="环比变化" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ===== 分类分布图（条形图） ===== -->
            <TextBlock Text="📂 分类分布" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12" />
            <Border Style="{StaticResource CardStyle}" Padding="20" MinHeight="200">
                <StackPanel x:Name="CategoryChartPanel">
                    <!-- 动态生成分类条形图 -->
                </StackPanel>
            </Border>

            <!-- ===== 每日趋势图（简易柱状图） ===== -->
            <TextBlock Text="📈 每日趋势" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12" />
            <Border Style="{StaticResource CardStyle}" Padding="20" MinHeight="220">
                <StackPanel x:Name="DailyTrendPanel">
                    <!-- 动态生成每日柱状图 -->
                </StackPanel>
            </Border>

            <!-- ===== Top 应用排行 ===== -->
            <TextBlock Text="🏆 应用使用排行" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel x:Name="TopAppsPanel">
                    <!-- 动态生成 Top 应用列表 -->
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
