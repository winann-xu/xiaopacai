<!-- [TASK-D3-04] 小趴菜家长端 App.xaml — 成品级品牌主题 -->
<!-- 全局应用资源、品牌色板、浅色/深色主题 -->
<Application x:Class="XiaopacaiParent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design 主题基础 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />

                <!-- 品牌色：绿色主色 + 蓝色辅色 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Green.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== [TASK-D3-04] 品牌色板 ===== -->
            <!-- 主品牌色：绿色系（成长·安全） -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="#1B5E20" />

            <!-- 辅品牌色：蓝色系（信任·稳定） -->
            <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#1976D2" />
            <SolidColorBrush x:Key="BrandSecondaryLightBrush" Color="#42A5F5" />

            <!-- 功能色 -->
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="BrandWarningBrush" Color="#FF9800" />
            <SolidColorBrush x:Key="BrandErrorBrush" Color="#E53935" />
            <SolidColorBrush x:Key="BrandInfoBrush" Color="#2196F3" />

            <!-- 文本色 -->
            <SolidColorBrush x:Key="BrandTextPrimaryBrush" Color="#212121" />
            <SolidColorBrush x:Key="BrandTextSecondaryBrush" Color="#757575" />
            <SolidColorBrush x:Key="BrandTextOnPrimaryBrush" Color="White" />

            <!-- ===== 全局样式 ===== -->

            <!-- 页面标题 -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Foreground" Value="#212121" />
            </Style>

            <!-- 二级标题 -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,12" />
                <Setter Property="Foreground" Value="#424242" />
            </Style>

            <!-- 卡片容器 — 带阴影圆角 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="BorderBrush" Value="#E8ECF0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.08"
                                          Color="#000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 品牌按钮（绿色主色） -->
            <Style x:Key="BrandButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#2E7D32" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,4" />
            </Style>

            <!-- 品牌轮廓按钮 -->
            <Style x:Key="BrandOutlineButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush" Value="#2E7D32" />
                <Setter Property="Foreground" Value="#2E7D32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="16,4" />
            </Style>

            <!-- 导航栏品牌色覆盖 -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#388E3C" />
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="White" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#2E7D32" />
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="White" />

        </ResourceDictionary>
    </Application.Resources>
</Application>

