<!-- [TASK-D1-03] 小趴菜家长端主窗口 -->
<!-- 左侧导航 + 右侧内容区的经典管理台布局 -->
<Window x:Class="XiaopacaiParent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:XiaopacaiParent.Views"
        Title="小趴菜家长端" Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />  <!-- 导航栏 -->
            <ColumnDefinition Width="*" />     <!-- 内容区 -->
        </Grid.ColumnDefinitions>

        <!-- === 左侧导航栏 === -->
        <Border Grid.Column="0" Background="#2E7D32">
            <StackPanel>
                <!-- 应用 Logo / 标题 -->
                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,24">
                    <Image x:Name="LogoImage" Width="48" Height="48"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="小趴菜" Foreground="White"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- 导航按钮列表 -->
                <Button Content="📊 仪表盘" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalAlignment="Stretch"
                        Click="OnDashboardClick" Height="48" />
                <Button Content="📱 设备管理" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalAlignment="Stretch"
                        Click="OnDevicesClick" Height="48" />
                <Button Content="📋 策略配置" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalAlignment="Stretch"
                        Click="OnPolicyClick" Height="48" />
                <Button Content="📢 公告管理" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalAlignment="Stretch"
                        Click="OnAnnouncementsClick" Height="48" />
                <Button Content="📈 使用报告" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalAlignment="Stretch"
                        Click="OnReportsClick" Height="48" />
                <Button Content="⚙️ 设置" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White" HorizontalAlignment="Stretch"
                        Click="OnSettingsClick" Height="48" />
            </StackPanel>
        </Border>

        <!-- === 右侧内容区 === -->
        <Frame Grid.Column="1" x:Name="ContentFrame"
               NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
